{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yu-zora-prisma-abyss",
  "compatibility_date": "2026-08-20",
  "main": "worker/index.js",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  }
}
